generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String            @id @default(cuid())
  name          String
  email         String            @unique
  passwordHash  String
  phone         String?
  address       String?
  emailVerified DateTime?         @default(now())
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  funds         UserFund[]
  investments   InvestmentEntry[]
}

model EmailVerification {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
}

model Fund {
  id               String        @id
  slug             String        @unique
  name             String
  shortName        String
  fundManager      String
  category         String        @default("Growth")
  biniUrl          String        @default("https://bini.com.bd/funds")
  primaryUrl       String?
  fallbackUrl      String?
  defaultNav       Float         @default(10.0)
  latestNav        Float?
  buyPrice         Float?
  sellPrice        Float?
  navEffectiveDate String?
  lastScrapedAt    DateTime?
  lastScrapeSource String?
  lastScrapeStatus String?
  lastScrapeError  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  userFunds        UserFund[]
  snapshots        NavSnapshot[]
  scrapeLogs       ScrapeLog[]
}

model UserFund {
  id                    String            @id @default(cuid())
  userId                String
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  fundId                String
  fund                  Fund              @relation(fields: [fundId], references: [id], onDelete: Cascade)
  monthlySipTarget      Float             @default(8000)
  totalUnits            Int               @default(0)   // Strictly whole INTEGER units
  totalInvested         Float             @default(0.0) // Capital deposited into units
  averageBuyPrice       Float             @default(0.0) // Weighted average cost
  fractionalCashBalance Float             @default(0.0) // Unallotted cash remainder to settle on next SIP
  totalCipUnits         Int               @default(0)   // Integer units credited via CIP
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  investments           InvestmentEntry[]
  cipTransactions       CipTransaction[]

  @@unique([userId, fundId])
  @@index([userId])
}

model InvestmentEntry {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userFundId     String
  userFund       UserFund  @relation(fields: [userFundId], references: [id], onDelete: Cascade)
  monthKey       String    // e.g. "2026-10", "2026-11"
  calendarMonth  String    // e.g. "October 2026", "November 2026"
  investmentDate DateTime  @default(now())
  cashInvested   Float     // Fresh cash amount deposited for this investment
  cashBufferUsed Float     @default(0.0) // Unsettled cash from previous installment
  executionNav   Float     // Execution NAV
  unitsAllotted  Int       // Strictly integer units floor((cashInvested + cashBufferUsed) / executionNav)
  unitsCost      Float     // unitsAllotted * executionNav
  cashRemainder  Float     @default(0.0) // Remainder held as cash buffer for next SIP
  type           String    @default("SIP") // "SIP", "LUMPSUM", "CIP"
  notes          String?
  createdAt      DateTime  @default(now())

  @@unique([userFundId, monthKey, type])
  @@index([userId, monthKey])
}

model NavSnapshot {
  id          String   @id @default(cuid())
  fundId      String
  fund        Fund     @relation(fields: [fundId], references: [id], onDelete: Cascade)
  dateKey     String   // YYYY-MM-DD
  displayDate String   // e.g. "11 Nov 2026"
  nav         Float
  buyPrice    Float?
  sellPrice   Float?
  source      String   @default("PRIMARY")
  scrapedAt   DateTime @default(now())

  @@unique([fundId, dateKey])
  @@index([dateKey])
}

model PortfolioHistory {
  id                 String   @id @default(cuid())
  userId             String?
  dateKey            String   @unique // YYYY-MM-DD
  displayDate        String
  totalInvested      Float
  currentMarketValue Float
  absoluteGainLoss   Float
  returnPct          Float
  shantaNav          Float?
  idlcNav            Float?
  edgeNav            Float?
  recordedAt         DateTime @default(now())

  @@index([dateKey])
}

model ScrapeLog {
  id            String   @id @default(cuid())
  fundId        String?
  fund          Fund?    @relation(fields: [fundId], references: [id], onDelete: SetNull)
  trigger       String   // "MANUAL", "CRON", "STARTUP"
  sourceUsed    String   // "PRIMARY", "FALLBACK", "FAILED"
  urlAttempted  String
  status        String   // "SUCCESS", "FALLBACK_SUCCESS", "ERROR"
  extractedNav  Float?
  effectiveDate String?
  durationMs    Int?
  message       String?
  createdAt     DateTime @default(now())
}

model CipTransaction {
  id                   String    @id @default(cuid())
  userFundId           String
  userFund             UserFund  @relation(fields: [userFundId], references: [id], onDelete: Cascade)
  dividendAmount       Float     // Declared dividend payout value in BDT
  cipNav               Float     // Reinvestment NAV used
  unitsAllotted        Int       // Strictly INTEGER units allotted
  reinvestedAmount     Float     // unitsAllotted * cipNav
  cashRemainder        Float     // Fractional remainder held as cash balance (BDT)
  isSettled            Boolean   @default(false)
  settledAt            DateTime?
  settledWithSipAmount Float?
  notes                String?
  createdAt            DateTime  @default(now())
}
